{
  "manifest_version": 3,
  "name": "Revendo — brouillons Vinted",
  "short_name": "Revendo",
  "description": "Prépare tes annonces Vinted depuis le téléphone : photos + prix, l'extension reconnaît l'article et crée le brouillon sur le bon compte. Ne publie jamais à ta place.",
  "version": "3.2.2",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Ouvrir Revendo",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "alarms",
    "scripting",
    "debugger",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.vinted.fr/*",
    "https://*.vinted.com/*",
    "https://*.vinted.de/*",
    "https://*.vinted.es/*",
    "https://*.vinted.it/*",
    "https://*.vinted.pt/*",
    "https://*.vinted.nl/*",
    "https://*.vinted.be/*",
    "https://*.vinted.co.uk/*",
    "https://*.vinted.pl/*",
    "https://*.vinted.at/*",
    "https://*.vinted.lu/*",
    "https://api.github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://openrouter.ai/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.vinted.fr/items/new*",
        "https://*.vinted.com/items/new*",
        "https://*.vinted.de/items/new*",
        "https://*.vinted.es/items/new*",
        "https://*.vinted.it/items/new*",
        "https://*.vinted.pt/items/new*",
        "https://*.vinted.nl/items/new*",
        "https://*.vinted.be/items/new*",
        "https://*.vinted.co.uk/items/new*",
        "https://*.vinted.pl/items/new*",
        "https://*.vinted.at/items/new*",
        "https://*.vinted.lu/items/new*"
      ],
      "js": [
        "content/vinted-fill.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
